    "microsoft-cognitiveservices-speech-sdk": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
