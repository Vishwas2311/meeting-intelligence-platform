# Development proxy only; never put provider/API secrets into VITE variables.
VITE_API_URL=http://127.0.0.1:8100
# Production uses same-origin /api and public OIDC registration values at build time.
# VITE_OIDC_AUTHORITY=https://identity.company.example/tenant
# VITE_OIDC_CLIENT_ID=public-spa-client-id
# VITE_OIDC_SCOPE=openid profile Meeting.Access
# VITE_SPEECH_REGION=approved-region
