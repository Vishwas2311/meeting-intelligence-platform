# Copy outside the repository. All values are placeholders requiring company inputs.
APP_ENV=production
AUTH_MODE=jwt
APP_API_TOKEN=
API_CLIENT_KEYS={}
API_ADMIN_CLIENTS=[]
PUBLIC_ORIGIN=https://meetings.company.example
CORS_ORIGINS=
DATABASE_URL=oracle
ORACLE_USER=meeting_runtime
ORACLE_DSN=oracle.company.example:1521/MEETINGS
ORACLE_PASSWORD_FILE=/run/secrets/oracle_password
STORAGE_DIR=/data/audio
JWT_ISSUER=https://identity.company.example/tenant
JWT_AUDIENCE=meeting-api
JWT_JWKS_URL=https://identity.company.example/tenant/keys
JWT_REQUIRED_PERMISSION=Meeting.Access
JWT_ADMIN_ROLE=Meeting.Admin
BROWSER_RECOVERY_ENABLED=false
# Enable only when the consumer adopts browser recovery, then supply:
# LOCAL_CACHE_KEK_FILE=/run/secrets/browser_cache_kek
LOCAL_CACHE_KEK_ID=v1
# For rotation: LOCAL_CACHE_OLD_KEKS_FILE=/run/secrets/previous_browser_cache_keks
AZURE_SPEECH_REGION=company-region
AZURE_SPEECH_KEY_FILE=/run/secrets/speech_key
AZURE_SPEECH_FAST_ENDPOINT=https://approved-speech.example/transcriptions?api-version=approved
LLM_ENDPOINT=https://approved-model.example/chat/completions?api-version=approved
LLM_MODEL=approved-model
LLM_API_KEY_FILE=/run/secrets/llm_key
LLM_MAX_OUTPUT_TOKENS=4000
LLM_MAX_INPUT_CHARS=30000
PROVIDER_MAX_CONCURRENCY=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=10
JOB_DEADLINE_SECONDS=1800
ACTOR_REQUESTS_PER_MINUTE=600
ACTOR_UPLOADS_PER_MINUTE=60
ACTOR_SPEECH_TOKENS_PER_MINUTE=12
ACTOR_JOBS_PER_HOUR=10
ACTOR_PENDING_JOBS=2
ACTOR_STORAGE_BYTES=2147483648
MAX_RESERVED_UPLOAD_BYTES=524288000
DAILY_LLM_CALLS=100
DAILY_TRANSCRIPTION_CALLS=30
# Defaults are candidates: approval/version must be supplied before production starts.
POLICY_APPROVED=false
USAGE_POLICY_VERSION=
AUDIO_RETENTION_ENABLED=false
RETENTION_POLICY_VERSION=
AUDIO_RETENTION_DAYS=30
