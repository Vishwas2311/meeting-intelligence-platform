# Copy to .env inside api-service only. Never copy credentials from the old application.
# Choose api_key for backend-to-backend clients OR jwt for company-issued access tokens.
AUTH_MODE=api_key
API_CLIENT_KEYS={}
API_ADMIN_CLIENTS=[]
# Explicit local-only fallback. Prefer API_CLIENT_KEYS for integrations.
APP_API_TOKEN=

# JWT mode: configure from your identity team. RS256 only; HTTPS JWKS and exact issuer/audience.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
JWT_REQUIRED_PERMISSION=Meeting.Access
JWT_ADMIN_ROLE=Meeting.Admin

# Add only the approved UI origins. Empty means no browser cross-origin access.
CORS_ORIGINS=
# Defaults are api-service/var; isolated from the original application's history.
# DATABASE_URL=sqlite:///var/meeting_intelligence.db
# STORAGE_DIR=var/audio

AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
AZURE_SPEECH_FAST_ENDPOINT=

# Full supported chat-completions URL and configured model/deployment name.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
LLM_RESPONSE_FORMAT=json_schema
LLM_MAX_INPUT_CHARS=30000
LLM_REQUEST_INTERVAL_SECONDS=2

AUDIO_RETENTION_ENABLED=false
AUDIO_RETENTION_DAYS=30
MAX_AUDIO_CHUNK_MB=16
MAX_RECAP_AUDIO_MB=100


# OPTIONAL ORACLE - leave DATABASE_URL unchanged for SQLite.
# DATABASE_URL=oracle
ORACLE_USER=
ORACLE_PASSWORD=
# Easy Connect example: localhost:1521/FREEPDB1 (use your DBA's actual service).
ORACLE_DSN=
# Optional Thin-mode wallet/TNS settings; directory must be accessible on this host.
ORACLE_CONFIG_DIR=
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=

# Docker Compose database selector; host DATABASE_URL is not reused inside Linux.
# CONTAINER_DATABASE_URL=oracle
# Default: sqlite:////srv/service/var/meeting_intelligence.db

# Development/test uses SQLite. Production is Oracle + JWT only; see deploy/production.env.example.
APP_ENV=development
PUBLIC_ORIGIN=
LOCAL_CACHE_KEK=
LOCAL_CACHE_KEK_ID=v1
LOCAL_CACHE_OLD_KEKS={}
POLICY_APPROVED=false
USAGE_POLICY_VERSION=
RETENTION_POLICY_VERSION=
ACTOR_REQUESTS_PER_MINUTE=600
ACTOR_UPLOADS_PER_MINUTE=60
ACTOR_SPEECH_TOKENS_PER_MINUTE=12
ACTOR_JOBS_PER_HOUR=10
ACTOR_PENDING_JOBS=2
ACTOR_STORAGE_BYTES=2147483648
MAX_RESERVED_UPLOAD_BYTES=524288000
DAILY_LLM_CALLS=100
DAILY_TRANSCRIPTION_CALLS=30
PROVIDER_MAX_CONCURRENCY=1
LLM_MAX_OUTPUT_TOKENS=4000
# Secrets may use NAME_FILE instead of NAME; never configure both.
