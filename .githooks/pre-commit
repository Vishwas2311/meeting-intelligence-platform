#!/bin/sh
set -eu
repo_root=$(git rev-parse --show-toplevel)
if [ -f "$repo_root/api-service/.venv/Scripts/python.exe" ]; then
  python_exe="$repo_root/api-service/.venv/Scripts/python.exe"
elif [ -f "$repo_root/api-service/.venv/bin/python" ]; then
  python_exe="$repo_root/api-service/.venv/bin/python"
else
  echo "Create api-service/.venv and install requirements-dev.txt before committing." >&2
  exit 1
fi
exec "$python_exe" "$repo_root/api-service/scripts/verify_release.py" --quick --backend-only
