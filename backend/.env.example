# ============================================================
# 1. APPLICATION CONFIGURATION
# ============================================================
APP_NAME=Meeting Intelligence API
# Defaults use the local OS application-data folder, outside the project/OneDrive.
# Override only for a deliberate storage location or PostgreSQL deployment.
# DATABASE_URL=sqlite:///C:/MeetingIntelligence/meeting_intelligence.db
# STORAGE_DIR=C:/MeetingIntelligence/audio
# Comma-separated frontend origins allowed to access the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local development authentication token; keep the real value in .env only.
APP_API_TOKEN=replace-with-a-long-random-local-development-token


# ============================================================
# 2. AZURE SPEECH - LIVE TRANSCRIPTION
# ============================================================
# Azure region short name, for example eastus.
AZURE_SPEECH_REGION=
# Speech HTTPS origin, for example https://eastus.api.cognitive.microsoft.com.
AZURE_SPEECH_ENDPOINT=
# Primary Azure Speech subscription key.
AZURE_SPEECH_KEY=
# Backup key for manual rotation; live authentication uses AZURE_SPEECH_KEY.
AZURE_SPEECH_KEY_SECONDARY=


# ============================================================
# 3. AZURE SPEECH - FAST TRANSCRIPTION (OPTIONAL)
# ============================================================
# Recover the complete saved recording after a known live transcription outage.
# Use the full transcriptions:transcribe URL including ?api-version=2025-10-15.
AZURE_SPEECH_FAST_ENDPOINT=
AZURE_SPEECH_FAST_API_VERSION=


# ============================================================
# 4. LLM CONFIGURATION - MINUTES OF MEETING (MOM)
# ============================================================
# Full chat-completions URL: OpenAI https://api.openai.com/v1/chat/completions.
# Azure OpenAI v1 instead uses https://YOUR-RESOURCE.openai.azure.com/openai/v1/chat/completions.
# LLM_MODEL is an OpenAI model (for example gpt-4.1-mini) or an Azure deployment name.
# OpenAI and Azure v1 need no dated API version; versioned providers require it in the URL.
LLM_ENDPOINT=
LLM_API_KEY=
# Backup key for manual rotation; the provider currently uses LLM_API_KEY.
LLM_API_KEY_SECONDARY=
LLM_MODEL=
LLM_API_VERSION=
# Maximum transcript characters for a single LLM request.
LLM_MAX_INPUT_CHARS=30000
# Prefer strict schema output; use json_object only for providers without schema support.
LLM_RESPONSE_FORMAT=json_schema
# Minimum delay after a successful LLM call; Azure Retry-After takes precedence on failures.
LLM_REQUEST_INTERVAL_SECONDS=2


# ============================================================
# 5. RECORDING AND AUDIO STORAGE
# ============================================================
# Opt-in only. Text/MoM history is never automatically deleted.
# Latest 10 meetings, active jobs and incomplete recordings are protected.
AUDIO_RETENTION_ENABLED=false
AUDIO_RETENTION_DAYS=30
# Maximum size of each uploaded audio chunk in megabytes.
MAX_AUDIO_CHUNK_MB=16
