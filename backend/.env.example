# ============================================================
# 1. APPLICATION CONFIGURATION
# ============================================================
APP_NAME=Meeting Intelligence API
DATABASE_URL=sqlite:///./meeting_intelligence.db
STORAGE_DIR=./data
# Comma-separated frontend origins allowed to access the API.
CORS_ORIGINS=http://localhost:5173
# Local development authentication token; keep the real value in .env only.
APP_API_TOKEN=replace-with-a-long-random-local-development-token


# ============================================================
# 2. AZURE SPEECH - LIVE TRANSCRIPTION
# ============================================================
# Azure region short name, for example centralindia.
AZURE_SPEECH_REGION=
# Speech resource HTTPS origin, for example https://YOUR-RESOURCE.cognitiveservices.azure.com.
AZURE_SPEECH_ENDPOINT=
# Primary Azure Speech subscription key.
AZURE_SPEECH_KEY=
# Optional secondary Azure Speech subscription key.
AZURE_SPEECH_KEY_SECONDARY=


# ============================================================
# 3. AZURE SPEECH - FAST TRANSCRIPTION (OPTIONAL)
# ============================================================
# Recorded-audio transcription adapter; not used for live streaming.
AZURE_SPEECH_FAST_ENDPOINT=
AZURE_SPEECH_FAST_API_VERSION=


# ============================================================
# 4. LLM CONFIGURATION - MINUTES OF MEETING (MOM)
# ============================================================
# Full chat-completions URL; Azure OpenAI v1 uses /openai/v1/chat/completions.
# LLM_MODEL must be your Azure deployment name; v1 needs no dated API version.
LLM_ENDPOINT=
LLM_API_KEY=
# Backup key for manual rotation; the provider currently uses LLM_API_KEY.
LLM_API_KEY_SECONDARY=''
LLM_MODEL='gpt-6.1-sol'
LLM_API_VERSION=
# Maximum transcript characters for a single LLM request.
LLM_MAX_INPUT_CHARS=100000


# ============================================================
# 5. RECORDING AND AUDIO STORAGE
# ============================================================
# Intended recording retention period in days.
AUDIO_RETENTION_DAYS=30
# Maximum size of each uploaded audio chunk in megabytes.
MAX_AUDIO_CHUNK_MB=16
